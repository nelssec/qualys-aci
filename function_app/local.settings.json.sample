    "ACR_CONNECTOR_NAME": "qualys-aci-connector",
    "ACR_APPLICATION_ID": "<service-principal-app-id>",
    "ACR_CLIENT_SECRET": "<service-principal-secret>",
    "SCAN_CACHE_HOURS": "24",
    "SERVICEBUS_CONNECTION_STRING": "<service-bus-connection-string>",
    "SERVICEBUS_QUEUE_NAME": "scan-notifications"
  }
}
